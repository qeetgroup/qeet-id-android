<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Debug builds only: delivers a push message from adb (docs/firebase.md). DUMP is held by the shell and not
          grantable to apps, so nothing on the phone can send it.
        -->
        <receiver
            android:name=".debug.DebugPushReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
