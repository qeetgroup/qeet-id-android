<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: plain HTTP is allowed, so the app can talk to a development server on your machine through
  `adb reverse tcp:4001 tcp:4001` (qeetid.apiUrl=http://127.0.0.1:4001 in local.properties). Release builds use
  src/main's HTTPS-only file.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
