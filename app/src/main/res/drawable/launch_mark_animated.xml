<?xml version="1.0" encoding="utf-8"?>
<!-- The launch icon's entrance (the mockup's qi-enter): from 95 % and transparent to its size, over motion.duration.slow
     (300 ms) with motion.easing.enter, then still. With animations off, it is simply there. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/launch_mark">
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@interpolator/qeetrix_easing_enter"
                    android:propertyName="scaleX"
                    android:valueFrom="0.95"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@interpolator/qeetrix_easing_enter"
                    android:propertyName="scaleY"
                    android:valueFrom="0.95"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="disc">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@interpolator/qeetrix_easing_enter"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="keyhole">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@interpolator/qeetrix_easing_enter"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
