<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen's icon (the Launch mockup): Qeet ID's round mark, 128 dp, in the middle of the 288 dp the system
     splash screen draws an icon without a background at (it sizes the drawable to that box, so the viewport is in
     those dp; the declared size only keeps Lint's 200 dp limit). The same geometry and gradient as
     qeet_id_mark_round. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <group
        android:name="mark"
        android:pivotX="144"
        android:pivotY="144">
        <group
            android:scaleX="1.28"
            android:scaleY="1.28"
            android:translateX="80"
            android:translateY="80">
            <path
                android:name="disc"
                android:pathData="M0,50a50,50 0,1 0,100 0a50,50 0,1 0,-100 0Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:endX="80"
                        android:endY="100"
                        android:startX="20"
                        android:startY="0"
                        android:type="linear">
                        <item android:color="#DA653A" android:offset="0" />
                        <item android:color="#D04800" android:offset="0.45" />
                        <item android:color="#9B3314" android:offset="1" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:name="keyhole"
                android:fillColor="#FFFFFF"
                android:fillType="evenOdd"
                android:pathData="M21,50a29,29 0,1 0,58 0a29,29 0,1 0,-58 0ZM46.2,50.6L43.5,64.5H56.5L53.8,50.6A8.5,8.5 0,1 0,46.2 50.6Z" />
        </group>
    </group>
</vector>
