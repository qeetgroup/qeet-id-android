<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of this app leaves the phone in a backup or a transfer to a new phone (Android 12 and later; below that,
  android:allowBackup="false" covers it). The secrets are encrypted with a key that never leaves this phone's
  Keystore, so a copy could not be read anywhere else anyway, and an account restored without its secret would be
  worse than none: sign-in codes are moved by setting them up again on the new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
