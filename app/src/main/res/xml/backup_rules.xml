<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and earlier: nothing is backed up (android:allowBackup="false" already says so; these rules say it again
  for any backup agent that reads them). Android 12 and later read data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
