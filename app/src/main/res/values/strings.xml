    <!-- Getting started -->
    <string name="welcome_title">Sign in safely, with this phone</string>
    <string name="welcome_body">Your sign-in codes, and a quick way to confirm it’s you when you sign in to Qeet ID.</string>
    <string name="welcome_codes_title">Sign-in codes</string>
    <string name="welcome_codes_body">For Qeet ID and any site with 2-step verification. They work offline.</string>
    <string name="welcome_approvals_title">Approve sign-ins</string>
    <string name="welcome_approvals_body">Confirm it\'s you when you sign in to Qeet ID on a computer.</string>
    <string name="welcome_kept_title">Kept on this phone</string>
    <string name="welcome_kept_body">Secrets stay in the phone\'s secure hardware. Qeet ID never receives them.</string>
    <string name="welcome_get_started">Get started</string>
    <string name="onboarding_step">Step %1$d of %2$d</string>
    <string name="lock_setup_title">Lock Qeet ID</string>
    <string name="lock_setup_body">Ask for your fingerprint, face or screen lock each time the app opens. Someone holding your unlocked phone still can\'t read your codes.</string>
    <string name="lock_switch_label">App lock</string>
    <string name="lock_switch_description">Fingerprint, face or PIN</string>
    <string name="lock_needs_screen_lock">Set a screen lock on this phone first: a PIN, pattern or password</string>
    <string name="lock_setup_approvals_note">Approving a Qeet ID sign-in always asks for your fingerprint or PIN.</string>
    <string name="notifications_title">Get sign-in requests on this phone</string>
    <string name="notifications_body">Qeet ID asks you to approve each sign-in to your account. Allow notifications so the requests reach you.</string>
    <string name="notifications_denied">Turn on notifications for Qeet ID in Settings so sign-in requests reach you.</string>
    <string name="notifications_footnote">Only sign-in requests. Nothing else, no marketing.</string>

