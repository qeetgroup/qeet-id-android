    <!-- Linking -->
    <string name="link_title">Link this phone</string>
    <string name="link_intro">Approve Qeet ID sign-ins here instead of typing a code. You need Qeet ID open on a computer.</string>
    <string name="link_step1_title">Open Qeet ID on your computer</string>
    <string name="link_step1_body">Go to Account, then Security</string>
    <string name="link_step2_title">Choose Link a phone</string>
    <string name="link_step2_body">Under Two-step verification</string>
    <string name="link_step3_title">Scan the code it shows</string>
    <string name="link_step3_body">It works once, for a few minutes</string>
