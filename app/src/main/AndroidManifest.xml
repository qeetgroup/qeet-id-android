<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Qeet ID API: linking, sign-in requests and unlinking. Sign-in codes never need the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To say "You're offline" on the home screen. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Scanning a QR code: a 2-step setup page, or the pairing code in Qeet ID. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Sign-in requests, Android 13 and later. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Hides other apps' overlay windows while Qeet ID is in front (Android 12 and later): no tapjacking. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".QeetIdApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QeetId"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              The QR code Qeet ID shows under Link a phone holds qeetidauth://pair?code=…, so the phone's own camera
              opens the app on it. The app always asks before linking.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="qeetidauth" />
            </intent-filter>
        </activity>

        <!-- Sign-in requests by Firebase Cloud Messaging, and push token changes. -->
        <service
            android:name=".approvals.push.QeetIdMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- No push token until the phone is linked: a phone that never links never registers with Firebase. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="push-mfa" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_qeet_id" />
    </application>

</manifest>
